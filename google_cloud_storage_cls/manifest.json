{
    "name": "Google Cloud Storage",
    "id": "google_cloud_storage_cls",
    "version": "2.0.0",
    "module": "CLS",
    "minimum_version": "6.1.0",
    "mapping": "Google Cloud Storage Default Mappings",
    "netskope": false,
    "types": [
        "alerts",
        "events",
        "webtx"
    ],
    "format_options": [
        {
            "label": "JSON",
            "value": "json"
        }
    ],
    "description": "This plugin supports ingestion of Alerts (DLP, Malware, Policy, Compromised Credential, Malsite, Quarantine, Remediation, Security Assessment, Watchlist, UBA, CTEP, Device, Content), Events (Page, Application, Audit, Infrastructure, Network, Incident, Endpoint, Client Status) and WebTx. The data will be ingested as JSON Lines objects, either gzip-compressed or uncompressed based on the Compression parameter, inside a bucket of the Google Cloud Storage. This plugin supports ingestion in JSON format only.",
    "configuration": [
        {
            "label": "Key File",
            "key": "key_file",
            "type": "textarea",
            "default": "",
            "mandatory": true,
            "placeholder": "Paste the contents of the Service Account JSON key file",
            "description": "Contents of the Service Account key file in JSON format. It can be created from Google Cloud Console > IAM & Admin > Service Accounts > select the account > Keys > Add Key > Create new key > JSON."
        },
        {
            "label": "Bucket Name",
            "key": "bucket_name",
            "type": "text",
            "default": "",
            "mandatory": true,
            "placeholder": "e.g. netskope-webtx-logs",
            "description": "Name of the bucket in which the data objects will be stored. The bucket is created if it does not exist and the Service Account is allowed to create buckets. Bucket names must be 3 to 63 characters long and can contain only lowercase letters, numbers, dashes, underscores and dots."
        },
        {
            "label": "Region Name",
            "key": "location",
            "type": "choice",
            "choices": [
                {
                    "key": "US (Data centers in the United States) [Multi-Region]",
                    "value": "US"
                },
                {
                    "key": "EU (Data centers within European Union) [Multi-Region]",
                    "value": "EU"
                },
                {
                    "key": "ASIA (Data centers in Asia) [Multi-Region]",
                    "value": "ASIA"
                },
                {
                    "key": "ASIA1 (ASIA-NORTHEAST1 and ASIA-NORTHEAST2) [Dual-Region]",
                    "value": "ASIA1"
                },
                {
                    "key": "EUR4 (EUROPE-NORTH1 and EUROPE-WEST4) [Dual-Region]",
                    "value": "EUR4"
                },
                {
                    "key": "NAM4 (US-CENTRAL1 and US-EAST1) [Dual-Region]",
                    "value": "NAM4"
                },
                {
                    "key": "NORTHAMERICA-NORTHEAST1 (Montréal) [Single-Region]",
                    "value": "NORTHAMERICA-NORTHEAST1"
                },
                {
                    "key": "NORTHAMERICA-NORTHEAST2 (Toronto) [Single-Region]",
                    "value": "NORTHAMERICA-NORTHEAST2"
                },
                {
                    "key": "US-CENTRAL1 (Iowa) [Single-Region]",
                    "value": "US-CENTRAL1"
                },
                {
                    "key": "US-EAST1 (South Carolina) [Single-Region]",
                    "value": "US-EAST1"
                },
                {
                    "key": "US-EAST4 (Northern Virginia) [Single-Region]",
                    "value": "US-EAST4"
                },
                {
                    "key": "US-WEST1 (Oregon) [Single-Region]",
                    "value": "US-WEST1"
                },
                {
                    "key": "US-WEST2 (Los Angeles) [Single-Region]",
                    "value": "US-WEST2"
                },
                {
                    "key": "US-WEST3 (Salt Lake City) [Single-Region]",
                    "value": "US-WEST3"
                },
                {
                    "key": "US-WEST4 (Las Vegas) [Single-Region]",
                    "value": "US-WEST4"
                },
                {
                    "key": "SOUTHAMERICA-EAST1 (São Paulo) [Single-Region]",
                    "value": "SOUTHAMERICA-EAST1"
                },
                {
                    "key": "EUROPE-CENTRAL2 (Warsaw) [Single-Region]",
                    "value": "EUROPE-CENTRAL2"
                },
                {
                    "key": "EUROPE-NORTH1 (Finland) [Single-Region]",
                    "value": "EUROPE-NORTH1"
                },
                {
                    "key": "EUROPE-WEST1 (Belgium) [Single-Region]",
                    "value": "EUROPE-WEST1"
                },
                {
                    "key": "EUROPE-WEST2 (London) [Single-Region]",
                    "value": "EUROPE-WEST2"
                },
                {
                    "key": "EUROPE-WEST3 (Frankfurt) [Single-Region]",
                    "value": "EUROPE-WEST3"
                },
                {
                    "key": "EUROPE-WEST4 (Netherlands) [Single-Region]",
                    "value": "EUROPE-WEST4"
                },
                {
                    "key": "EUROPE-WEST6 (Zürich) [Single-Region]",
                    "value": "EUROPE-WEST6"
                },
                {
                    "key": "ASIA-EAST1 (Taiwan) [Single-Region]",
                    "value": "ASIA-EAST1"
                },
                {
                    "key": "ASIA-EAST2 (Hong Kong) [Single-Region]",
                    "value": "ASIA-EAST2"
                },
                {
                    "key": "ASIA-NORTHEAST1 (Tokyo) [Single-Region]",
                    "value": "ASIA-NORTHEAST1"
                },
                {
                    "key": "ASIA-NORTHEAST2 (Osaka) [Single-Region]",
                    "value": "ASIA-NORTHEAST2"
                },
                {
                    "key": "ASIA-NORTHEAST3 (Seoul) [Single-Region]",
                    "value": "ASIA-NORTHEAST3"
                },
                {
                    "key": "ASIA-SOUTH1 (Mumbai) [Single-Region]",
                    "value": "ASIA-SOUTH1"
                },
                {
                    "key": "ASIA-SOUTH2 (Delhi) [Single-Region]",
                    "value": "ASIA-SOUTH2"
                },
                {
                    "key": "ASIA-SOUTHEAST1 (Singapore) [Single-Region]",
                    "value": "ASIA-SOUTHEAST1"
                },
                {
                    "key": "ASIA-SOUTHEAST2 (Jakarta) [Single-Region]",
                    "value": "ASIA-SOUTHEAST2"
                },
                {
                    "key": "AUSTRALIA-SOUTHEAST1 (Sydney) [Single-Region]",
                    "value": "AUSTRALIA-SOUTHEAST1"
                },
                {
                    "key": "AUSTRALIA-SOUTHEAST2 (Melbourne) [Single-Region]",
                    "value": "AUSTRALIA-SOUTHEAST2"
                },
                {
                    "key": "Custom Region",
                    "value": "custom"
                }
            ],
            "default": "US",
            "mandatory": true,
            "description": "Location used while creating the bucket. It is ignored if the bucket already exists. Select 'Custom Region' to provide a location that is not in the list.",
            "has_api_call": true,
            "payload_fields": [
                "location"
            ]
        }
    ]
}