{
    "name": "TrendAI Vision One",
    "id": "trend_micro",
    "version": "2.0.0",
    "module": "CTE",
    "minimum_version": "6.1.0",
    "description": "This plugin is used to pull Domains, File SHA-256, IP address (IPv4, IPv6) and URLs from the TrendAI Vision One > Threat Intelligence > Suspicious Object Management > Suspicious Object List. This plugin allows sharing of Domains, File SHA-256, IP address (IPv4, IPv6) and URLs to TrendAI Vision One's Suspicious Object List or Exception List. This plugin supports pull retraction of indicators from the Suspicious Object List and push retraction of shared indicators from both the Suspicious Object List and Exception List.",
    "patch_supported": true,
    "fetch_retraction_info": true,
    "delete_supported": true,
    "configuration": [
        {
            "label": "Data Region",
            "key": "data_region",
            "type": "choice",
            "choices": [
                {
                    "key": "Australia (api.au.xdr.trendmicro.com)",
                    "value": "https://api.au.xdr.trendmicro.com"
                },
                {
                    "key": "Canada (api.ca.xdr.trendmicro.com)",
                    "value": "https://api.ca.xdr.trendmicro.com"
                },
                {
                    "key": "European Union (api.eu.xdr.trendmicro.com)",
                    "value": "https://api.eu.xdr.trendmicro.com"
                },
                {
                    "key": "India (api.in.xdr.trendmicro.com)",
                    "value": "https://api.in.xdr.trendmicro.com"
                },
                {
                    "key": "Indonesia (api.id.xdr.trendmicro.com)",
                    "value": "https://api.id.xdr.trendmicro.com"
                },
                {
                    "key": "Japan (api.jp.xdr.trendmicro.com)",
                    "value": "https://api.jp.xdr.trendmicro.com"
                },
                {
                    "key": "Middle East & Africa (api.mea.xdr.trendmicro.com)",
                    "value": "https://api.mea.xdr.trendmicro.com"
                },
                {
                    "key": "Singapore (api.sg.xdr.trendmicro.com)",
                    "value": "https://api.sg.xdr.trendmicro.com"
                },
                {
                    "key": "South Africa (api.za.xdr.trendmicro.com)",
                    "value": "https://api.za.xdr.trendmicro.com"
                },
                {
                    "key": "United Kingdom (api.uk.xdr.trendmicro.com)",
                    "value": "https://api.uk.xdr.trendmicro.com"
                },
                {
                    "key": "United States (api.xdr.trendmicro.com)",
                    "value": "https://api.xdr.trendmicro.com"
                },
                {
                    "key": "Custom Region",
                    "value": "Custom Region"
                }
            ],
            "mandatory": true,
            "default": "https://api.au.xdr.trendmicro.com",
            "description": "Select the data region from which you want to pull your data. Select 'Custom Region' to provide your own Base URL.",
            "has_api_call": true,
            "payload_fields": [
                "data_region"
            ]
        }
    ]
}
